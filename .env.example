PORT=3000

# Comma-separated frontend origins allowed to call the API.
# Example:
# CORS_ORIGINS=https://yourname.github.io,http://localhost:5500
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Keep true for local full-stack run, set false on Render if frontend is hosted separately.
SERVE_STATIC=true

# Set false only if you want to block all GitHub Pages domains by default.
ALLOW_GITHUB_PAGES=true

# Wix OAuth and billing configuration
# WIX_CLIENT_ID=
# WIX_CLIENT_SECRET=
# WIX_PAID_PLAN_IDS=
# WIX_UPGRADE_URL=
# Optional:
# WIX_OAUTH_REDIRECT_URI=
# WIX_OAUTH_SCOPE=
